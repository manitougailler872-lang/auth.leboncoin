<!doctype html>
<html lang="fr">
    <body style="margin: 0; padding: 0; background: #f5f7f9; font-family: Arial, Helvetica, sans-serif">
        <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
                <td align="center" style="padding: 40px 15px">
                    <table
                        width="600"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="width: 100%; max-width: 600px; background: #ffffff; border: 1px solid #e4e8ed"
                    >
                        {% if product.auth %}
                             <tr>
                                <td style="padding: 30px">
                                    <div style="font-size: 24px; font-weight: bold; color: #102544">
                                        <span style="color: #ff6e14">Borderau  - Réf: {{product.transactionReference}}</span>
                                    </div>
                                    <p style="color: #617084; line-height: 22px">
                                        L' acheteur à confirmer l'envoi du bordereau pour l'article  <strong> {{ product.title }} - {{ product.amount|number_format( 2, ',', ' ' ) }} € </strong>
                                    </p>

                                    <p style="color: #617084; line-height: 22px">
                                        Votre bordereau de paiement est disponible en pièce jointe au format PDF.
                                    </p>

                                    <p style="margin-top: 30px; color: #8592a2; font-size: 12px">
                                        Référence :  {{product.transactionReference}}
                                    </p>
                                </td>
                            </tr>
                        {% else %}
                             <tr>
                            <td style="padding: 30px">
                                <div style="font-size: 24px; font-weight: bold; color: #102544">
                                    <span style="color: #ff6e14">Borderau </span>
                                </div>
                                <p style="color: #617084; line-height: 22px">
                                    L' acheteur à confirmer l'envoi du bordereau</strong>
                                </p>
                                <p style="color: #617084; line-height: 22px">
                                    Votre bordereau de paiement est disponible en pièce jointe au format PDF.
                                </p>
                            </td>
                        </tr>
                        {% endif %}
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
