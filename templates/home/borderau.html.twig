{% extends 'shared/_layout.html.twig' %}
{% block body %}
<!-- ================================================== -->
<!-- PAGE -->
<!-- ================================================== -->

<main class="relative min-h-[calc(100vh-80px)] overflow-x-hidden bg-[#FBFCFD]">
    <!-- ================================================== -->
    <!-- DECORATION ARRIERE PLAN -->
    <!-- ================================================== -->

    <div class="pointer-events-none absolute left-0 top-1/2 hidden w-full -translate-y-1/2 opacity-60 lg:block">
        <svg viewBox="0 0 1600 300" class="w-full" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- ========================================== -->
            <!-- LEFT BUILDINGS -->
            <!-- ========================================== -->

            <rect x="110" y="140" width="55" height="100" rx="4" fill="#EEF2F6" />

            <rect x="175" y="100" width="65" height="140" rx="4" fill="#F3F5F8" />

            <rect x="195" y="72" width="16" height="28" rx="3" fill="#EEF2F6" />

            <!-- WINDOWS -->

            <rect x="130" y="170" width="10" height="10" fill="#FFFFFF" />

            <rect x="150" y="170" width="10" height="10" fill="#FFFFFF" />

            <rect x="195" y="130" width="11" height="11" fill="#FFFFFF" />

            <rect x="218" y="130" width="11" height="11" fill="#FFFFFF" />

            <!-- ========================================== -->
            <!-- LEFT TREE -->
            <!-- ========================================== -->

            <rect x="66" y="188" width="5" height="50" fill="#D9DEE4" />

            <circle cx="69" cy="179" r="25" fill="#DDF5E8" />

            <circle cx="52" cy="187" r="17" fill="#DDF5E8" />

            <circle cx="84" cy="192" r="18" fill="#DDF5E8" />

            <!-- ========================================== -->
            <!-- ORANGE TREE -->
            <!-- ========================================== -->

            <rect x="270" y="194" width="5" height="45" fill="#D9DEE4" />

            <circle cx="272" cy="185" r="22" fill="#FFE0CB" />

            <circle cx="257" cy="191" r="15" fill="#FFE0CB" />

            <circle cx="286" cy="193" r="15" fill="#FFE0CB" />

            <!-- ========================================== -->
            <!-- RIGHT BUILDINGS -->
            <!-- ========================================== -->

            <rect x="1300" y="140" width="60" height="100" rx="4" fill="#EEF2F6" />

            <rect x="1380" y="110" width="65" height="130" rx="4" fill="#F3F5F8" />

            <rect x="1320" y="115" width="18" height="25" fill="#EEF2F6" />

            <!-- WINDOWS -->

            <rect x="1320" y="170" width="10" height="10" fill="#FFFFFF" />

            <rect x="1340" y="170" width="10" height="10" fill="#FFFFFF" />

            <rect x="1400" y="140" width="11" height="11" fill="#FFFFFF" />

            <rect x="1423" y="140" width="11" height="11" fill="#FFFFFF" />

            <!-- ========================================== -->
            <!-- RIGHT TREE -->
            <!-- ========================================== -->

            <rect x="1490" y="188" width="5" height="50" fill="#D9DEE4" />

            <circle cx="1493" cy="177" r="24" fill="#DDF5E8" />

            <circle cx="1477" cy="189" r="16" fill="#DDF5E8" />

            <circle cx="1508" cy="190" r="16" fill="#DDF5E8" />
        </svg>
    </div>

 <div class="w-full max-w-[520px] mx-auto">
    <!-- ================================================== -->
    <!-- ZONE CENTRALE -->
    <!-- ================================================== -->

    <div
        class="relative z-10 flex min-h-[calc(100vh-80px)] w-full items-center justify-center px-4 py-10 sm:px-6 sm:py-12 lg:px-8"
    >
        <!-- ================================================== -->
        <!-- CARD -->
        <!-- ================================================== -->
        <section
            class="w-full max-w-[680px] rounded-[24px] border border-[#E9EDF1] bg-white px-5 py-8 shadow-[0_8px_10px_rgba(15,23,42,0.10)] sm:px-9 sm:py-9 lg:px-12 lg:py-10"
        >
            <!-- ================================================== -->
            <!-- SUCCESS ICON -->
            <!-- ================================================== -->
            <div class="flex justify-center">
                <div
                    class="relative flex h-[120px] w-[120px] items-center justify-center rounded-full bg-[#EFFBF2] sm:h-[140px] sm:w-[140px]"
                >
                    <!-- DOT LEFT -->
                    <span class="absolute left-[-12px] top-[25px] h-2.5 w-2.5 rounded-full bg-[#27C840]"></span>
                    <!-- DOT RIGHT -->
                    <span class="absolute right-[-10px] top-[34px] h-2 w-2 rounded-full bg-[#27C840]/20"></span>
                    <!-- CHECK -->
                    <svg
                        class="h-[70px] w-[70px] text-[#20C33A] sm:h-[105px] sm:w-[105px]"
                        viewBox="0 0 120 120"
                        fill="none"
                    >
                        <circle cx="55" cy="63" r="37" stroke="currentColor" stroke-width="5" />
                        <path
                            d="M36 60L51 75L90 34"
                            stroke="currentColor"
                            stroke-width="12"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                    </svg>
                </div>
            </div>

            <!-- ================================================== -->
            <!-- TITLE -->
            <!-- ================================================== -->
            {% if product.auth %}
                <div class="mt-5 text-center">
                    <h1 class="text-[30px] font-extrabold leading-tight tracking-[-0.8px] text-[#0D2341] sm:text-[36px]">
                        Félicitations !
                    </h1>
                    <p class="mx-auto mt-4 max-w-[540px] text-[16px]  leading-7 text-[#172A3D] sm:text-[17px]">
                        Votre bordereau de paiement n° <span class="font-bold">{{product.transactionReference}}</span>  concernant l'article
                        <span class="text-nexo-600 font-bold">{{product.title}} - {{product.amount}} {{product.currency}}</span>
                        <span>à bien été transféré </span>
                        à votre vendeur.
                    </p>
                    <p class="mx-auto mt-2 max-w-[520px] text-[14px] leading-6 text-[#5C6D80] sm:text-[15px]">
                        Le vendeur va être notifié et pourra procéder à l’expédition de votre commande.
                    </p>
                </div>
            {% else %}
                    <div class="mt-5 text-center">
                    <h1 class="text-[30px] font-extrabold leading-tight tracking-[-0.8px] text-[#0D2341] sm:text-[36px]">
                        Félicitations !
                    </h1>
                    <p class="mx-auto mt-4 max-w-[540px] text-[16px]  leading-7 text-[#172A3D] sm:text-[17px]">
                        Votre bordereau de paiement à bien été transféré 
                        à votre vendeur.
                    </p>
                    <p class="mx-auto mt-2 max-w-[520px] text-[14px] leading-6 text-[#5C6D80] sm:text-[15px]">
                        Le vendeur va être notifié et pourra procéder à l’expédition de votre commande.
                    </p>
                </div>
            {% endif %}

            <!-- ================================================== -->
            <!-- SECURE INFO -->
            <!-- ================================================== -->

            <div
                class="mt-7 flex items-start gap-4 rounded-[16px] border border-[#CFEFD5] bg-[#F5FCF6] px-4 py-4 sm:px-5"
            >
                <!-- SHIELD -->

                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white text-[#20C33A]">
                    <svg
                        class="h-7 w-7"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />

                        <path d="m9 12 2 2 4-4" />
                    </svg>
                </div>

                <!-- TEXT -->

                <div>
                    <h2 class="text-[15px] font-extrabold text-[#0D2341] sm:text-[16px]">Paiement sécurisé</h2>

                    <p class="mt-1 text-[13px] leading-5 text-[#526273] sm:text-[14px] sm:leading-6">
                        Votre paiement est protégé par Leboncoin. Vous serez informé dès que votre colis sera expédié.
                    </p>
                </div>
            </div>
        </section>
    </div>

 </div>
    <!-- ================================================== -->
    <!-- FOOTER -->
    <!-- ================================================== -->

    <section
        class="relative z-10 mx-auto grid w-full max-w-[1050px] grid-cols-1 gap-6 border-t border-[#E9EDF1] px-6 py-8 md:grid-cols-3 md:gap-10 lg:px-0"
    >
        <!-- ================================================== -->
        <!-- SECURITY -->
        <!-- ================================================== -->

        <div class="flex items-center gap-4">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#F4F7FA] text-[#8EA0B8]">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />

                    <path d="m9 12 2 2 4-4" />
                </svg>
            </div>

            <div>
                <p class="text-[14px] font-extrabold text-[#1B3150]">Paiement 100% sécurisé</p>

                <p class="mt-0.5 text-[12px] text-[#718096]">Vos données sont protégées</p>
            </div>
        </div>

        <!-- ================================================== -->
        <!-- SUPPORT -->
        <!-- ================================================== -->

        <div class="flex items-center gap-4">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#F4F7FA] text-[#8EA0B8]">
                <svg
                    class="h-6 w-6"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z" />

                    <path d="M8 10h.01"></path>

                    <path d="M12 10h.01"></path>

                    <path d="M16 10h.01"></path>
                </svg>
            </div>

            <div>
                <p class="text-[14px] font-extrabold text-[#1B3150]">Un problème ?</p>

                <p class="mt-0.5 text-[12px] text-[#718096]">Notre service client est là pour vous</p>
            </div>
        </div>

        <!-- ================================================== -->
        <!-- PROTECTION -->
        <!-- ================================================== -->

        <div class="flex items-center gap-4">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#F4F7FA] text-[#8EA0B8]">
                <svg
                    class="h-6 w-6"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <rect x="5" y="10" width="14" height="11" rx="2" />

                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                </svg>
            </div>

            <div>
                <p class="text-[14px] font-extrabold text-[#1B3150]">Protection Leboncoin</p>

                <p class="mt-0.5 text-[12px] text-[#718096]">Profitez de notre protection acheteurs</p>
            </div>
        </div>
    </section>

    <!-- ================================================== -->
    <!-- COPYRIGHT -->
    <!-- ================================================== -->

    <footer class="relative z-10 border-t border-[#EEF1F4] bg-white px-5 py-5 text-center">
        <p class="text-[12px] text-[#8A98A8]">© 2026 Leboncoin. Tous droits réservés.</p>
    </footer>
   
</main>

{% endblock %}