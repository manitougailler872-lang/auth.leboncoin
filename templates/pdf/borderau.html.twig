<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />

        <style>
            @page {
                margin: 20px;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                padding: 0;
                font-family: "DejaVu Sans", sans-serif;
                color: #172a3d;
                font-size: 12px;
                background: #ffffff;
            }

            .document {
                width: 100%;
                border: 1px solid #e3e8ed;
                border-radius: 12px;
            }

            .header {
                padding: 24px 28px;
                border-bottom: 1px solid #e8edf1;
            }

            .logo {
                font-size: 23px;
                font-weight: bold;
                color: #102544;
            }

            .logo span {
                color: #ff6e14;
            }

            .subtitle {
                margin-top: 4px;
                font-size: 9px;
                color: #8996a5;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            .status {
                padding: 30px;
                text-align: center;
            }

            .check {
                width: 52px;
                height: 52px;

                margin: 0 auto 14px auto;

                border: 2px solid #22a653;
                border-radius: 50%;

                color: #22a653;

                font-size: 28px;
                line-height: 48px;
                font-weight: bold;
            }

            .status-title {
                margin: 0;

                font-size: 24px;
                font-weight: bold;

                color: #102544;

                text-transform: uppercase;
            }

            .success-text {
                margin-top: 7px;
                color: #68788b;
            }

            .amount {
                margin-top: 20px;

                font-size: 32px;
                font-weight: bold;

                color: #ff6e14;
            }

            .amount-label {
                margin-top: 4px;

                font-size: 9px;
                color: #7d8997;

                text-transform: uppercase;
            }

            .section {
                padding: 0 28px 25px 28px;
            }

            .section-title {
                padding-bottom: 10px;

                border-bottom: 1px solid #dce2e8;

                font-size: 13px;
                font-weight: bold;

                text-transform: uppercase;

                color: #172a3d;
            }

            .section-title span {
                color: #ff6e14;
            }

            .product {
                width: 100%;
                margin-top: 18px;

                border-collapse: collapse;
            }

            .product-image {
                width: 42%;
                padding-right: 22px;

                vertical-align: top;
            }

            .product-info {
                width: 58%;
                padding-left: 22px;

                border-left: 1px solid #e5e9ed;

                vertical-align: top;
            }

            .product-image img {
                width: 100%;
                max-height: 230px;

                object-fit: cover;

                border: 1px solid #e3e8ed;
                border-radius: 7px;
            }

            .label-title {
                color: #8290a0;
                font-size: 10px;
            }

            .product-name {
                margin-top: 6px;

                font-size: 14px;
                font-weight: bold;

                line-height: 20px;
            }

            .description {
                margin-top: 5px;

                color: #4f6073;
                line-height: 18px;
            }

            .specs {
                width: 100%;

                margin-top: 14px;

                border-collapse: collapse;
            }

            .specs td {
                padding: 7px 0;

                border-bottom: 1px solid #e8ecf0;
            }

            .spec-label {
                font-weight: bold;
            }

            .spec-value {
                text-align: right;
            }

            .payment {
                width: 100%;

                margin-top: 10px;

                border-collapse: collapse;
            }

            .payment td {
                padding: 11px 0;

                border-bottom: 1px solid #e8ecf0;
            }

            .payment-label {
                color: #526376;
            }

            .payment-value {
                text-align: right;
                font-weight: bold;
            }

            .status-paid {
                color: #209447;
                font-weight: bold;
            }

            .footer-note {
                margin: 0 28px 25px 28px;

                padding-top: 16px;

                border-top: 1px solid #ffb087;

                color: #607086;
                font-size: 10px;
                line-height: 16px;
            }
        </style>
    </head>

    <body>
        <div class="document">

            <!-- HEADER -->
            <div class="header">
                <div class="logo">
                    <img src="data:image/png;base64," />
                </div>
                <div class="subtitle">Paiement sécurisé</div>
            </div>

            <!-- PAYMENT SUCCESS -->

            <div class="status">
                <div class="check">✓</div>

                <h1 class="status-title">Paiement effectué</h1>

                <div class="success-text">Votre paiement a été enregistré avec succès.</div>

                <div class="amount">{{ amount|number_format( 2, ',', ' ' ) }} €</div>

                <div class="amount-label">Montant payé</div>
            </div>

            <!-- VEHICULE -->

            <div class="section">
                <div class="section-title">
                    <span>●</span>

                    Détails du produit
                </div>

                <table class="product">
                    <tr>
                        <!-- IMAGE -->

                        <td class="product-image">
                            {% if vehicule.fromtImage %}

                            <img
                                src="{{ absolute_url(
                                asset(
                                    vehicule.fromtImage
                                )
                            ) }}"
                                alt=""
                            />

                            {% endif %}
                        </td>

                        <!-- INFOS -->
                        <td class="product-info">
                            <div class="label-title">Libellé</div>
                            <div class="product-name">{{ vehicule.label }}</div>
                            {% if vehicule.description %}
                            <div class="description">{{ vehicule.description }}</div>
                            {% endif %}
                            <table class="specs">
                                <tr>
                                    <td class="spec-label">Marque</td>

                                    <td class="spec-value">{{ vehicule.brand }}</td>
                                </tr>
                                <tr>
                                    <td class="spec-label">Modèle</td>

                                    <td class="spec-value">{{ vehicule.model }}</td>
                                </tr>
                                <tr>
                                    <td class="spec-label">Année modèle</td>

                                    <td class="spec-value">{{ vehicule.year}}</td>
                                </tr>
                                <tr>
                                    <td class="spec-label">Kilométrage</td>

                                    <td class="spec-value">
                                        {{ vehicule.kilometrage|number_format( 0, ',', ' ' ) }} km
                                    </td>
                                </tr>
                                <tr>
                                    <td class="spec-label">Boîte de vitesse</td>

                                    <td class="spec-value">{{ vehicule.transmission }}</td>
                                </tr>
                                <tr>
                                    <td class="spec-label">Énergie</td>

                                    <td class="spec-value">{{ vehicule.energie }}</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </div>
            <!-- PAYMENT DETAILS -->
            <div class="section">
                <div class="section-title">
                    <span>●</span>

                    Détails du paiement
                </div>
                <table class="payment">
                    <tr>
                        <td class="payment-label">Date du paiement</td>

                        <td class="payment-value">{{ paidAt|date( 'd/m/Y à H:i' ) }}</td>
                    </tr>
                    <tr>
                        <td class="payment-label">Moyen de paiement</td>

                        <td class="payment-value">{{ paymentMethod }}</td>
                    </tr>
                    <tr>
                        <td class="payment-label">Référence de transaction</td>

                        <td class="payment-value">{{ transactionReference }}</td>
                    </tr>
                    <tr>
                        <td class="payment-label">Statut</td>

                        <td class="payment-value status-paid">✓ Effectué</td>
                    </tr>
                    <tr>
                        <td class="payment-label">Montant</td>

                        <td class="payment-value">{{ amount|number_format( 2, ',', ' ' ) }} €</td>
                    </tr>
                </table>
            </div>
            <div class="footer-note">
                Ce bordereau récapitule les informations de la transaction enregistrée.
                <br />
                Conservez-le avec vos justificatifs de transaction.
            </div>
        </div>
    </body>
</html>
